{
  "//": "Same compilerOptions as foundation's tsconfig.base.json (TS 7.0.2). Once in the workspace this can become { \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"types\": [\"node\"] }, \"include\": [\"src\", \"test\"] }.",
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "test",
    "sim"
  ]
}
