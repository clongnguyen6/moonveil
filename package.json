{
  "name": "moonveil",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "node scripts/env.mjs node scripts/dev.mjs",
    "build": "node scripts/env.mjs npm run build -w @moonveil/web",
    "start": "node scripts/env.mjs node apps/server/src/main.ts",
    "typecheck": "node scripts/env.mjs npm run typecheck --workspaces --if-present",
    "test": "node scripts/env.mjs npm run test --workspaces --if-present",
    "e2e:install": "node scripts/env.mjs npx playwright install --only-shell chromium",
    "e2e": "node scripts/env.mjs npm run e2e -w @moonveil/e2e",
    "check": "npm run typecheck && npm test && npm run e2e"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
